---
/**
 * Header.astro - App top header with brand and quick links.
 * PUBLIC_INTERFACE: Renders the application header.
 */
const { title = "College Bus" } = Astro.props;
---
<header class="header-app">
  <div class="mx-auto max-w-7xl px-4 py-3 flex items-center justify-between">
    <a href="/" class="font-semibold text-primary hover:text-primary/90 transition-colors">{title}</a>
    <nav class="hidden md:flex items-center gap-3 text-sm text-slate-700 dark:text-slate-200">
      <a href="/" class="hover:text-primary">Home</a>
      <a href="/student" class="hover:text-primary">Student</a>
      <a href="/admin" class="hover:text-primary">Admin</a>
      <a href="/routes" class="hover:text-primary">Bus Routes</a>
      <a href="/reports" class="hover:text-primary">Reports</a>
    </nav>
  </div>
</header>
