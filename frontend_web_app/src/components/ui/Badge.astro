---
/**
 * Badge.astro - Small status label.
 * PUBLIC_INTERFACE
 * Props:
 *  - color?: 'primary' | 'secondary' | 'accent' | 'neutral'
 */
const { color = 'neutral' } = Astro.props;
const colorMap: Record<string, string> = {
  primary: 'bg-primary/15 text-primary ring-primary/30',
  secondary: 'bg-secondary/15 text-secondary ring-secondary/30',
  accent: 'bg-accent/15 text-accent ring-accent/30',
  neutral: 'bg-slate-200/50 text-slate-700 dark:bg-slate-700/50 dark:text-slate-200 ring-slate-300/50',
};
---
<span class={`inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full ring-1 ${colorMap[color]}`}>
  <slot />
</span>
