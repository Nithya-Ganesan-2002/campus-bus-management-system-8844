---
/**
 * Sidebar.astro - Collapsible sidebar for app navigation.
 * PUBLIC_INTERFACE: Renders left sidebar with navigation.
 */
const navItems = [
  { href: "/", label: "Home", icon: "🏠" },
  { href: "/student", label: "Student Portal", icon: "🎓" },
  { href: "/admin", label: "Admin Portal", icon: "🛠️" },
  { href: "/routes", label: "Bus Routes", icon: "🚌" },
  { href: "/reports", label: "Reports", icon: "📊" },
];
---
<aside class="hidden md:flex md:w-64 shrink-0 border-r border-black/5 dark:border-white/10 bg-white/70 dark:bg-slate-900/60 backdrop-blur">
  <nav class="w-full p-4 space-y-1">
    {navItems.map((item) => (
      <a href={item.href} class="group flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-slate-700 dark:text-slate-200 hover:bg-primary/10 hover:text-primary transition-colors">
        <span class="text-lg leading-none">{item.icon}</span>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>
</aside>

<style>
  @media (max-width: 767px) {
    aside { display: none; }
  }
</style>
