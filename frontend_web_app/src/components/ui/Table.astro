---
/**
 * Table.astro - Reusable table shell.
 * PUBLIC_INTERFACE
 * Props:
 *  - headers: string[]
 */
interface Props { headers: string[] }
const { headers = [] } = Astro.props as Props;
---
<div class="overflow-x-auto">
  <table class="min-w-full border border-black/5 dark:border-white/10 rounded-lg overflow-hidden">
    <thead class="bg-slate-50 dark:bg-slate-800/60">
      <tr>
        {headers.map((h) => <th class="text-left text-xs font-semibold text-slate-600 dark:text-slate-300 px-4 py-3">{h}</th>)}
      </tr>
    </thead>
    <tbody class="[&_tr:nth-child(even)]:bg-slate-50/60 dark:[&_tr:nth-child(even)]:bg-slate-800/40">
      <slot />
    </tbody>
  </table>
</div>
