---
/**
 * FullWidth.astro - Optional layout without sidebar.
 * PUBLIC_INTERFACE: Use for pages that need all width.
 */
import ThemeToggle from '../components/ThemeToggle.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import LoginModal from '../components/LoginModal.astro';
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>College Bus Management</title>
  </head>
  <body class="container-page transition-colors duration-300">
    <Header title="College Bus" />
    <main class="flex-1 anim-fade-in">
      <ThemeToggle />
      <div class="mx-auto max-w-7xl px-4 py-6">
        <slot />
      </div>
    </main>
    <LoginModal />
    <script>
      window.addEventListener('login:open', () => {
        window.dispatchEvent(new CustomEvent('auth:change', { detail: { role: null } }));
      });
    </script>
    <Footer />
  </body>
</html>
