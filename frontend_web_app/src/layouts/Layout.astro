---
import ThemeToggle from '../components/ThemeToggle.astro';
import Header from '../components/ui/Header.astro';
import Sidebar from '../components/ui/Sidebar.astro';
import Footer from '../components/ui/Footer.astro';
import LoginModal from '../components/LoginModal.astro';
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>College Bus Management</title>
  </head>
  <body class="container-page transition-colors duration-300">
    <Header title="College Bus" />
    <div class="flex flex-1">
      <Sidebar />
      <main class="flex-1 anim-fade-in">
        <ThemeToggle />
        <div class="mx-auto max-w-7xl px-4 py-6">
          <slot />
        </div>
      </main>
    </div>
    <LoginModal />
    <script>
      // Allow header "Login" button to open the modal.
      window.addEventListener('login:open', () => {
        // Re-rendering LoginModal will auto-open when not logged in.
        // Trigger auth change so modal refreshes its open state.
        window.dispatchEvent(new CustomEvent('auth:change', { detail: { role: null } }));
      });
    </script>
    <Footer />
  </body>
</html>
