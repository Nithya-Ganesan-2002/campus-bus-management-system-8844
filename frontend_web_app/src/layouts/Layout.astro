---
import ThemeToggle from '../components/ThemeToggle.astro';
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>College Bus Management</title>
	</head>
	<body class="container-page transition-colors duration-300">
		<header class="header-app">
			<div class="mx-auto max-w-7xl px-4 py-3 flex items-center justify-between">
				<a href="/" class="font-semibold text-primary hover:text-primary/90 transition-colors">College Bus</a>
				<nav class="hidden md:flex items-center gap-3 text-sm text-slate-700 dark:text-slate-200">
					<a href="/" class="hover:text-primary">Home</a>
					<a href="#" class="hover:text-primary">Student</a>
					<a href="#" class="hover:text-primary">Admin</a>
				</nav>
			</div>
		</header>

		<main class="flex-1 anim-fade-in">
			<ThemeToggle />
			<slot />
		</main>

		<footer class="border-t border-black/5 dark:border-white/10 py-6 text-center text-xs text-slate-500 dark:text-slate-400">
			<div class="mx-auto max-w-7xl px-4">
				© {new Date().getFullYear()} College Bus Management. All rights reserved.
			</div>
		</footer>
	</body>
</html>
