---
import Layout from '../layouts/Layout.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import { listRoutesActive, getBusOccupancy, getEnvelope } from '../lib/services';
import { getRole } from '../lib/store/auth';
---

<Layout>
  <section class="section space-y-6">
    <Card title="Student Portal">
      <div id="student-content">
        <p class="mb-4">
          View routes, check seat availability, and register for a pass. Use the Bus Routes page to explore and book a seat.
        </p>
        <div id="student-gate" class="hidden">
          <p class="text-sm text-slate-600 dark:text-slate-300 mb-4">
            You are not logged in as Student. Please login to access the student portal.
          </p>
          <div class="flex gap-2">
            <button class="btn btn-secondary" id="open-login">Login</button>
            <a class="btn" href="/admin">Go to Admin</a>
          </div>
        </div>
        <div id="student-actions" class="flex flex-wrap gap-2">
          <a class="btn btn-primary" href="/routes">Browse Routes & Book</a>
        </div>
      </div>
    </Card>

    <Card title="Quick Glance: Active Routes">
      {
        (() => {
          const routes = listRoutesActive();
          const env = getEnvelope();
          const today = new Date().toISOString().slice(0,10);
          if (!routes.length) return <p class="text-sm text-slate-500 dark:text-slate-400">No active routes.</p>;
          return (
            <div class="grid gap-4 md:grid-cols-2">
              {routes.map((r) => {
                const buses = env.buses.filter((b) => b.routeId === r.id && b.status === 'active');
                const sch = env.schedules.find((s) => s.routeId === r.id && s.serviceDate === today);
                const occ = (buses[0] && sch) ? getBusOccupancy(buses[0].id, sch.id) : null;
                return (
                  <div class="p-4 rounded-lg border border-black/5 dark:border-white/10">
                    <div class="flex items-center justify-between">
                      <div class="font-semibold">{r.name}</div>
                      <Badge color="secondary">{buses.length} bus(es)</Badge>
                    </div>
                    <div class="text-xs text-slate-600 dark:text-slate-300 mt-1 truncate">Stops: {r.stops.join(', ')}</div>
                    <div class="mt-2 flex items-center gap-2 text-xs">
                      <span class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800">First {r.firstBusTime}</span>
                      <span class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800">Last {r.lastBusTime}</span>
                      {occ ? <span class="px-2 py-1 rounded bg-accent/10 text-accent">{occ.capacity - occ.available}/{occ.capacity}</span> : null}
                    </div>
                    <div class="mt-3">
                      <a class="btn btn-primary !px-3 !py-1.5" href={`/routes?routeId=${encodeURIComponent(r.id)}`}>View & Book</a>
                    </div>
                  </div>
                );
              })}
            </div>
          );
        })()
      }
    </Card>
  </section>

  <script>
    import { getRole, subscribe } from "../lib/store/auth.ts";

    function updateGate(role) {
      const gate = document.getElementById('student-gate');
      const actions = document.getElementById('student-actions');
      if (!gate || !actions) return;
      const allowed = role === 'student';
      gate.classList.toggle('hidden', allowed);
      actions.classList.toggle('hidden', !allowed);
    }

    function init() {
      updateGate(getRole());
      subscribe(updateGate);
      document.getElementById('open-login')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('login:open'));
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</Layout>
