---
import Layout from '../layouts/Layout.astro';
import Card from '../components/ui/Card.astro';
import Table from '../components/ui/Table.astro';
import Badge from '../components/ui/Badge.astro';
---

<Layout>
  <section class="section space-y-6">
    <Card title="Admin Portal">
      <div id="admin-content">
        <div id="admin-gate" class="hidden">
          <p class="text-sm text-slate-600 dark:text-slate-300 mb-4">
            You are not logged in as Admin. Please login to manage buses.
          </p>
          <div class="flex gap-2">
            <button class="btn btn-secondary" id="open-login">Login</button>
            <a class="btn" href="/student">Go to Student</a>
          </div>
        </div>

        <div id="admin-actions" class="flex flex-wrap gap-2">
          <a class="btn btn-primary" href="#" id="add-bus">Add Bus</a>
          <a class="btn btn-secondary" href="#" id="assign-driver">Assign Driver</a>
          <a class="btn btn-accent" href="#" id="update-schedule">Update Schedule</a>
        </div>
      </div>
    </Card>

    <Card title="Buses">
      <div id="admin-table-wrapper">
        <Table headers={["Bus", "Route", "Driver", "Occupancy", "Status"]}>
          <tr>
            <td class="px-4 py-3">Bus 12</td>
            <td class="px-4 py-3">Main Campus Loop</td>
            <td class="px-4 py-3">A. Kumar</td>
            <td class="px-4 py-3">28/40</td>
            <td class="px-4 py-3"><Badge color="secondary">Active</Badge></td>
          </tr>
          <tr>
            <td class="px-4 py-3">Bus 7</td>
            <td class="px-4 py-3">North Line</td>
            <td class="px-4 py-3">S. Rao</td>
            <td class="px-4 py-3">40/40</td>
            <td class="px-4 py-3"><Badge>Full</Badge></td>
          </tr>
        </Table>
      </div>
    </Card>
  </section>

  <script>
    import { getRole, subscribe } from "../lib/store/auth.ts";

    function updateGate(role) {
      const gate = document.getElementById('admin-gate');
      const actions = document.getElementById('admin-actions');
      const table = document.getElementById('admin-table-wrapper');
      if (!gate || !actions || !table) return;
      const allowed = role === 'admin';
      gate.classList.toggle('hidden', allowed);
      actions.classList.toggle('hidden', !allowed);
      table.classList.toggle('hidden', !allowed);
    }

    function init() {
      updateGate(getRole());
      subscribe(updateGate);
      document.getElementById('open-login')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('login:open'));
      });
      // Demo click handlers
      document.getElementById('add-bus')?.addEventListener('click', (e) => { e.preventDefault(); alert('Add bus (demo)'); });
      document.getElementById('assign-driver')?.addEventListener('click', (e) => { e.preventDefault(); alert('Assign driver (demo)'); });
      document.getElementById('update-schedule')?.addEventListener('click', (e) => { e.preventDefault(); alert('Update schedule (demo)'); });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</Layout>
