---
import Layout from '../layouts/Layout.astro';
import Card from '../components/ui/Card.astro';
import BusForm from '../components/admin/BusForm.astro';
import DriverAssignForm from '../components/admin/DriverAssignForm.astro';
import ScheduleForm from '../components/admin/ScheduleForm.astro';
import BusTable from '../components/admin/BusTable.astro';
import RouteManager from '../components/admin/RouteManager.astro';
---

<Layout>
  <section class="section space-y-6">
    <Card title="Admin Portal">
      <div id="admin-content">
        <div id="admin-gate" class="hidden">
          <p class="text-sm text-slate-600 dark:text-slate-300 mb-4">
            You are not logged in as Admin. Please login to manage buses.
          </p>
          <div class="flex gap-2">
            <button class="btn btn-secondary" id="open-login">Login</button>
            <a class="btn" href="/student">Go to Student</a>
          </div>
        </div>

        <div id="admin-actions" class="flex flex-wrap gap-2">
          <button class="btn btn-primary" id="btn-add-bus">Add Bus</button>
          <button class="btn btn-secondary" id="btn-assign-driver">Assign Driver</button>
          <button class="btn btn-accent" id="btn-add-schedule">Add Schedule</button>
          <button class="btn" id="btn-manage-routes">Manage Routes</button>
        </div>
      </div>
    </Card>

    <div id="admin-panels" class="space-y-6">
      <!-- Dynamic panels mount area -->
      <div id="panel-mount"></div>

      <BusTable onAction="admin:bus:action" />
    </div>
  </section>

  <script>
    import { getRole, subscribe } from "../lib/store/auth.ts";

    function el(id){ return document.getElementById(id); }
    function showPanel(html) {
      const m = el('panel-mount');
      if (m) m.innerHTML = html;
    }

    function updateGate(role) {
      const gate = el('admin-gate');
      const actions = el('admin-actions');
      const panels = el('admin-panels');
      if (!gate || !actions || !panels) return;
      const allowed = role === 'admin';
      gate.classList.toggle('hidden', allowed);
      actions.classList.toggle('hidden', !allowed);
      panels.classList.toggle('hidden', !allowed);
      if (!allowed) showPanel('');
    }

    function mountBusForm(busId = "") {
      showPanel(`<bus-form ${busId ? `bus-id="${busId}"` : ""} on-saved-event="admin:bus:saved"></bus-form>`);
    }
    function mountDriverAssign(busId = "") {
      showPanel(`<driver-assign-form bus-id="${busId}" on-assigned-event="admin:driver:assigned"></driver-assign-form>`);
    }
    function mountScheduleForm(scheduleId = "") {
      showPanel(`<schedule-form ${scheduleId ? `schedule-id="${scheduleId}"` : ""} on-saved-event="admin:schedule:saved"></schedule-form>`);
    }
    function mountRouteManager() {
      showPanel(`<route-manager></route-manager>`);
    }

    function init() {
      updateGate(getRole());
      subscribe(updateGate);

      el('open-login')?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('login:open')));

      el('btn-add-bus')?.addEventListener('click', () => mountBusForm());
      el('btn-assign-driver')?.addEventListener('click', () => mountDriverAssign(""));
      el('btn-add-schedule')?.addEventListener('click', () => mountScheduleForm());
      el('btn-manage-routes')?.addEventListener('click', () => mountRouteManager());

      // Listen to table actions
      window.addEventListener('admin:bus:action', (e) => {
        const detail = (e as CustomEvent).detail || {};
        if (detail?.type === 'edit' && detail?.busId) mountBusForm(detail.busId);
        if (detail?.type === 'assign' && detail?.busId) mountDriverAssign(detail.busId);
      });

      // After saves, clear panel
      window.addEventListener('admin:bus:saved', () => showPanel(''));
      window.addEventListener('admin:driver:assigned', () => showPanel(''));
      window.addEventListener('admin:schedule:saved', () => showPanel(''));
      window.addEventListener('admin:route:saved', () => showPanel(''));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</Layout>
