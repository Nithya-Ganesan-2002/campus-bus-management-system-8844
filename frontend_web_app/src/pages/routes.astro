---
import Layout from '../layouts/Layout.astro';
import Card from '../components/ui/Card.astro';
import RouteList from '../components/student/RouteList.astro';
import RouteDetail from '../components/student/RouteDetail.astro';
import SeatMap from '../components/student/SeatMap.astro';
import PassRegistrationForm from '../components/student/PassRegistrationForm.astro';
import { listRoutesActive } from '../lib/services';
---

<Layout>
  <section class="section space-y-6">
    <Card title="Bus Routes">
      <p class="text-slate-600 dark:text-slate-300">
        Explore all available routes and timings. Click a route to view details, seats, and booking options.
      </p>
    </Card>

    <div id="routes-view" class="space-y-6">
      <!-- If a query param ?routeId= is provided, show the detail; else show the list -->
      {
        (() => {
          const url = Astro.url;
          const routeId = url.searchParams.get('routeId');
          if (routeId) {
            return (
              <>
                <RouteDetail routeId={routeId} />
                {/* Hydrate seat map island once for initial state (client script in RouteDetail will refresh as selections change) */}
                <SeatMap busId="" scheduleId="" />
                <PassRegistrationForm routeId={routeId} busId="" scheduleId="" />
              </>
            );
          }
          return <RouteList />;
        })()
      }
    </div>
  </section>
</Layout>
